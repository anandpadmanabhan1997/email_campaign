# Example environment variables for fastapi-bulk-mail app
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
REPORTS_DIR=/data/reports

# Admin who receives campaign report
ADMIN_EMAIL=anandcelestis@gmail.com

# Email transport: 'mailhog' (dev) or 'smtp' (production)
MAIL_TRANSPORT=mailhog

# When MAIL_TRANSPORT=mailhog, the default SMTP host/port will be used (mailhog:1025).
# When MAIL_TRANSPORT=smtp, set the following SMTP connection details:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Celery / Redis
BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND=redis://redis:6379/1

# App tuning
BATCH_SIZE=200
WORKER_CONCURRENCY=4
RATE_LIMIT=10/s

# Prometheus optional
PROMETHEUS_ENABLED=true